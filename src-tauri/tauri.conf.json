{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuntyy AutoPrompt",
  "version": "0.1.16",
  "identifier": "com.kuntyy.autoprompt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kuntyy AutoPrompt",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/automation/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDN0E5RkUwRDk0QjEzN0QKUldSOUUwdlo0Sjk2L0c0L08xQ0tXcW9ENWQxYXVFd21FQXBnTnV1YmlzYjdvcXVwdnZ2OGpWaWMK",
      "endpoints": [
        "https://github.com/bisrib613/kuntyyflwprmpt/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
